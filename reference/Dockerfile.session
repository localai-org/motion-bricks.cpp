FROM pytorch/pytorch@sha256:7db0e1bf4b1ac274ea09cf6358ab516f8a5c7d3d0e02311bed445f7e236a5d80

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      git=1:2.34.1-1ubuntu1.17 \
      git-lfs=3.0.2-1ubuntu0.3 \
      gcc=4:11.2.0-1ubuntu1 \
      libgl1=1.4.0-1 \
      libglib2.0-0=2.72.4-0ubuntu2.9 \
      libx11-6=2:1.7.5-1ubuntu0.3 \
      libxext6=2:1.3.4-1build1 \
      libxrender1=1:0.9.10-1build4 \
    && rm -rf /var/lib/apt/lists/*

COPY session-requirements.lock /tmp/session-requirements.lock
RUN python -m pip install --no-cache-dir --no-deps --requirement /tmp/session-requirements.lock \
    && python -m pip check

ENV MOTIONBRICKS_REFERENCE_CONTAINER=1 \
    MOTIONBRICKS_SESSION_BASE_IMAGE=pytorch/pytorch@sha256:7db0e1bf4b1ac274ea09cf6358ab516f8a5c7d3d0e02311bed445f7e236a5d80 \
    MPLCONFIGDIR=/tmp/motionbricks-matplotlib \
    PYNPUT_BACKEND=dummy \
    PYTHONHASHSEED=0 \
    PYTHONPATH=/upstream/motionbricks

WORKDIR /work
ENTRYPOINT ["python", "/work/reference/run_session_baseline.py"]
