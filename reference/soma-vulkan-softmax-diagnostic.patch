 // num_iters is the number of BLOCK_SIZE loop iterations we need to iterate
 // over all the columns. The main function tries to pass a constant here,
 // as if it were a template function, to allow unrolling.
+// Diagnostic CUDA range reduction, without a calibration table.
+float soma_exp(float x) {
+    if (isinf(x) && x < 0.0) return 0.0;
+    precise float sat = clamp(fma(x, 0.005724980030208826, 0.5), 0.0, 1.0);
+    precise float product = sat * 252.0;
+    int integral = int(floor(product));
+    // Recover floor of the exact product if RN crossed an integer boundary.
+    if (product == float(integral) && fma(sat, 252.0, -product) < 0.0) --integral;
+    int n = integral - 126;
+    precise float reduced = fma(x, 1.4426950216293334961, -float(n));
+    reduced = fma(x, 1.925963033500011079e-08, reduced);
+    precise float result = exp2(reduced);
+    return ldexp(result, n);
+}
+
+float soma_divide(float numerator, float denominator) {
+    precise float quotient = numerator / denominator;
+    precise float residual = fma(-quotient, denominator, numerator);
+    return fma(residual, 1.0 / denominator, quotient);
+}
