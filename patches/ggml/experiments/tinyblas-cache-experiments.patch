+    constexpr int64_t block = 16;
+    for (int64_t row = 0; row < m; row += rows) {
+        const int64_t group = row / rows;
+        for (int64_t column = 0; column < k; column += block) {
+            for (int64_t lane = 0; lane < rows; ++lane) {
