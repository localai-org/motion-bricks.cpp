+const float * pack_f32_rows4(const float * source, int64_t m, int64_t k, int64_t lda) {
+    static std::mutex mutex;
+    static std::vector<std::unique_ptr<packed_f32_matrix>> cache;
+    const std::lock_guard lock(mutex);
+    for (const auto & entry : cache)
+        if (entry->source == source && entry->m == m && entry->k == k && entry->lda == lda)
+            return entry->values.data();
