# Build-only GGML overlay. Never mutate the pinned source checkout.
include("${CMAKE_CURRENT_LIST_DIR}/SomaVulkanBackend.cmake")
function(motionbricks_prepare_soma_vulkan result)
    if(NOT MOTIONBRICKS_ENABLE_GGML OR NOT MOTIONBRICKS_ENABLE_VULKAN)
        message(FATAL_ERROR "SOMA Vulkan shaders require GGML and Vulkan")
    endif()
    set(shader_source "${MOTIONBRICKS_GGML_SOURCE_DIR}/src/ggml-vulkan/vulkan-shaders")
    file(SHA256 "${shader_source}/norm.comp" norm_hash)
    file(SHA256 "${shader_source}/soft_max.comp" softmax_hash)
    if(NOT norm_hash STREQUAL "ca26cdf00c148c7b2c9b2be821402c83dfe70552fbbb038580b89805fbd3ead2" OR
       NOT softmax_hash STREQUAL "55eee4d0d55e203cc53f54367d61bb1b89850d40d8107b60c2d883eb929ba39e")
        message(FATAL_ERROR "SOMA Vulkan shader overlay requires the validated pinned GGML shader sources")
    endif()
    set(overlay "${CMAKE_BINARY_DIR}/soma-ggml-source")
    file(GLOB_RECURSE old_sources LIST_DIRECTORIES FALSE RELATIVE "${overlay}" "${overlay}/*")
    foreach(source IN LISTS old_sources)
        if(NOT EXISTS "${MOTIONBRICKS_GGML_SOURCE_DIR}/${source}")
            file(REMOVE "${overlay}/${source}")
        endif()
    endforeach()
    file(GLOB_RECURSE sources CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE RELATIVE "${MOTIONBRICKS_GGML_SOURCE_DIR}" "${MOTIONBRICKS_GGML_SOURCE_DIR}/*")
    foreach(source IN LISTS sources)
        if(source MATCHES "(^|/)\\.git(/|$)" OR source MATCHES "src/ggml-vulkan/vulkan-shaders/(norm|soft_max)\\.comp$")
            continue()
        endif()
        configure_file("${MOTIONBRICKS_GGML_SOURCE_DIR}/${source}" "${overlay}/${source}" COPYONLY)
    endforeach()
    # Preserve the original dependency identity instead of finding the parent repo.
    file(READ "${overlay}/CMakeLists.txt" ggml_cmake)
    string(REPLACE [=[WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}]=]
        "WORKING_DIRECTORY \"${MOTIONBRICKS_GGML_SOURCE_DIR}\"" ggml_cmake "${ggml_cmake}")
    string(REPLACE "include(CheckIncludeFileCXX)"
        [=[set(GGML_BUILD_COMMIT "${GGML_BUILD_COMMIT}-soma-shaders")
include(CheckIncludeFileCXX)]=] ggml_cmake "${ggml_cmake}")
    file(WRITE "${overlay}/CMakeLists.txt" "${ggml_cmake}")
    configure_file("${PROJECT_SOURCE_DIR}/src/vulkan/soma_norm.comp" "${overlay}/src/ggml-vulkan/vulkan-shaders/norm.comp" COPYONLY)
    configure_file("${PROJECT_SOURCE_DIR}/src/vulkan/soma_soft_max.comp" "${overlay}/src/ggml-vulkan/vulkan-shaders/soft_max.comp" COPYONLY)
    motionbricks_patch_soma_vulkan_backend("${overlay}")
    set(${result} "${overlay}" PARENT_SCOPE)
endfunction()
